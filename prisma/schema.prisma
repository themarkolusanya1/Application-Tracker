datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType    = "client"
}

model User {
  id                         String         @id @default(cuid())
  name                       String
  email                      String         @unique
  password                   String // Hashed password
  role                       String         @default("STUDENT") // "STUDENT" or "PROFESSIONAL"
  profilePicture             String? // Base64 profile avatar representation
  emailNotificationsEnabled Boolean        @default(true)
  deadlineRemindersEnabled  Boolean        @default(true)
  dailyMotivationEnabled     Boolean        @default(true)
  monthlyReportEnabled       Boolean        @default(true)
  applications               Application[]
  notifications              Notification[]
  sentEmailLogs              SentEmailLog[]
  createdAt                  DateTime       @default(now())
}

model Application {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationType String   @default("job") // "job" or "scholarship"
  organization    String // University, School, Company, etc.
  title           String // MSc/PhD Program, Job Role, Internship, etc.
  status          String // Represents pipeline status
  url             String?
  notes           String?
  salary          String? // Represents salary (job)
  locationType    String   @default("ON_SITE") // Represents location type (ON_SITE, HYBRID, REMOTE)
  location        String?  // Represents Location / City & Country (e.g. Zurich, Switzerland)
  appliedDate     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Multi-currency support
  currency String @default("USD")

  // Deadlines & Portal Opening dates
  fundingType   String? // "fully funded", "partial", "self-funded"
  stipendAmount String? // Stipend / funding amount
  openingDate   DateTime? // Application portal opening date
  deadline      DateTime? // Application deadline / closing date

  // Document checklist (true = completed, false = pending)
  hasSop               Boolean @default(false)
  hasTranscripts       Boolean @default(false)
  hasReferences        Boolean @default(false)
  hasTestScores        Boolean @default(false)
  hasCvResume          Boolean @default(false)
  hasPersonalStatement Boolean @default(false)
  hasCoverLetter       Boolean @default(false)

  // University academic details
  degreeLevel      String? // "Bachelors", "Masters", "PhD"
  potentialAdvisor String? // Supervisor contact info (for PhD)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SentEmailLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  emailType     String   // "DEADLINE_REMINDER", "DAILY_MOTIVATION", "MONTHLY_REPORT"
  sentAt        DateTime @default(now())
}

